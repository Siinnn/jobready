{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["cdg1"],
  "functions": {
    "src/app/api/analyze-cv/route.js": { "maxDuration": 60 },
    "src/app/api/letter-draft/route.js": { "maxDuration": 45 },
    "src/app/api/rewrite/route.js": { "maxDuration": 45 },
    "src/app/api/suggest/route.js": { "maxDuration": 45 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
