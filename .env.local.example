# ─── Service de génération de texte ───────────────────────────
# Clé d'API du fournisseur utilisé pour l'aide à la rédaction
ANTHROPIC_API_KEY=sk-ant-...

# Identifiants de modèles (facultatif — valeurs par défaut dans src/lib/ai.js)
# AI_MODEL_ADVANCED=
# AI_MODEL_FAST=
# AI_MODEL_FALLBACK=

# ─── Espace administrateur ────────────────────────────────────
# Code d'accès à l'espace admin (/admin) : recherche d'offres et
# analyse d'offres. Sans ce code, ces pages sont inaccessibles.
# Choisissez une valeur longue et unique.
ADMIN_CODE=changez-ce-code
ADMIN_NAME=Yanis

# ─── Recherche d'offres (espace admin uniquement) ─────────────
# Obtenir sur https://console.apify.com/account/integrations
APIFY_API_TOKEN=apify_api_...

# ─── Application ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
test finis 